; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Madness Area"
run/main_scene="res://scene/levels/main_menu.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
boot_splash/use_filter=false

[compression]

formats/zstd/compression_level=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale=2.0
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="TestGame"

[global_group]

Player=""

[gui]

common/snap_controls_to_pixels=false
theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0
theme/lcd_subpixel_layout=0
theme/custom="res://assets/themes/default_theme.tres"
theme/custom_font="res://assets/fonts/fff-forward/FFFFORWA.TTF"

