[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="pick_coin"
2d_physics/layer_5="pick_weapon"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/compress_with_gpu=false
textures/vram_compression/cache_gpu_compressor=false
textures/webp_compression/compression_method=1
textures/webp_compression/lossless_compression_factor=0.0
shader_compiler/shader_cache/compress=false
shader_compiler/shader_cache/use_zstd_compression=false
textures/default_filters/anisotropic_filtering_level=0
viewport/hdr_2d=true
textures/decals/filter=0
textures/light_projectors/filter=0
lightmapping/lightmap_gi/use_bicubic_filter=false
environment/volumetric_fog/use_filter=0
textures/basis_universal/zstd_supercompression=false
2d/snap/snap_2d_transforms_to_pixel=true
